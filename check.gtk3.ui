<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.10" />
  <object class="GtkWindow" id="check_dialog">
    <property name="title" translatable="yes">Check Installed Files</property>
    <property name="default-width">640</property>
    <property name="default-height">440</property>
    <property name="modal">False</property>
    <property name="window-position">center</property>
    <signal name="delete-event" handler="close_check_window" />
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">16</property>
        <child>
          <object class="GtkLabel" id="diagnostic_label">
            <property name="visible">True</property>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="shadow-type">in</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkTextView" id="main_list">
                <property name="visible">True</property>
                <property name="editable">False</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="dismiss_button">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Close</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
                <signal name="clicked" handler="on_dismiss_button_clicked" />
              </object>
            </child>
            <child>
              <object class="GtkButton" id="rescue_button">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Rescue</property>
                <property name="use-underline">True</property>
                <property name="sensitive">False</property>
                <signal name="clicked" handler="on_rescue_button_clicked" />
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="media_select">
    <property name="title" translatable="yes">Select Installation Media</property>
    <property name="default-width">500</property>
    <property name="default-height">200</property>
    <property name="modal">True</property>
    <property name="window-position">center</property>
    <signal name="delete-event" handler="close_media_window" />
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">16</property>
        <child>
          <object class="GtkRadioButton" id="cdrom_radio">
            <property name="visible">True</property>
            <property name="label" translatable="yes">CD-ROM</property>
            <property name="active">True</property>
            <signal name="toggled" handler="on_cdrom_radio_toggled" />
          </object>
        </child>
        <child>
          <object class="GtkRadioButton" id="dir_radio">
            <property name="visible">True</property>
            <property name="label" translatable="yes">Other directory:</property>
            <property name="group">cdrom_radio</property>
            <signal name="toggled" handler="on_dir_radio_toggled" />
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkEntry" id="dir_entry">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="pick_dir_but">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Browse…</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
                <signal name="clicked" handler="on_pick_dir_but_clicked" />
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="media_cancel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
                <signal name="clicked" handler="on_media_cancel_clicked" />
              </object>
            </child>
            <child>
              <object class="GtkButton" id="media_ok">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_OK</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
                <signal name="clicked" handler="on_media_ok_clicked" />
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
