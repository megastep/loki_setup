<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.10" />
  <object class="GtkWindow" id="setup_window">
    <property name="title" translatable="yes">Setup</property>
    <property name="default-width">600</property>
    <property name="default-height">420</property>
    <property name="modal">False</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">16</property>
        <child>
          <object class="GtkFrame" id="image_frame_top" />
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkFrame" id="image_frame" />
            </child>
            <child>
              <object class="GtkNotebook" id="setup_notebook">
                <property name="visible">True</property>
                <property name="show-tabs">False</property>
                <property name="show-border">False</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkBox" id="class_continue">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Select the type of installation to perform</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRadioButton" id="recommended_but">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Recommended</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkRadioButton" id="expert_but">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Expert</property>
                        <property name="group">recommended_but</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="class_cancel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Cancel</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="class_readme">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_View Readme</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="class_next">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Continue</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="options_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkFrame" id="global_frame">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin">8</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="label" translatable="yes">Install path:</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="install_path">
                                <property name="visible">True</property>
                                <property name="has-entry">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="binary_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="label" translatable="yes">Binary path:</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="binary_path">
                                <property name="visible">True</property>
                                <property name="has-entry">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkCheckButton" id="symlink_checkbox">
                                <property name="visible">True</property>
                                <property name="label" translatable="yes">Install a symbolic link into the path</property>
                                <property name="active">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="manpage_label">
                                <property name="visible">True</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="label" translatable="yes">Man page path:</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="manpage_combo">
                                <property name="visible">True</property>
                                <property name="has-entry">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="visible">True</property>
                        <property name="shadow-type">in</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="GtkBox" id="option_vbox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <property name="margin">8</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="free_space_label">
                            <property name="visible">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="label" translatable="yes">Free space:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_free_space">
                            <property name="visible">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="estim_size_label">
                            <property name="visible">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="label" translatable="yes">Estimated size:</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="label_install_size">
                            <property name="visible">True</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="setup_menuitems_checkbox">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Startup menu entries</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator" id="install_separator">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="options_status">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="button_cancel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Cancel</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_readme">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_View Readme</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_install">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Begin Install</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">False</property>
                    <style>
                      <class name="suggested-action" />
                    </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="copy_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel" id="current_option_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="current_file_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkProgressBar" id="current_file_progress">
                        <property name="visible">True</property>
                        <property name="show-text">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Total progress</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkProgressBar" id="total_file_progress">
                        <property name="visible">True</property>
                        <property name="show-text">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="cancel_progress_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Cancel</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="view_readme_progress_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_View Readme</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="done_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel" id="setup_complete_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="install_directory_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="play_game_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="finish_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Quit</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="view_readme_end_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_View Readme</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="play_game_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Play</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="abort_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Installation aborted.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="abort_exit">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Quit</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="warning_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel" id="warning_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="warning_cancel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Cancel</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="warning_continue">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Continue</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="website_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel" id="website_product_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="website_text_label">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Please visit our website for updates and support.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="auto_url_yes">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Launching browser, please wait...</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="auto_url_no">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="browser_button">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">Launch _Browser</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="website_cancel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Quit</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="website_readme">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_View Readme</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="website_next">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Continue</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="cdkey_page">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="margin">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Please enter your CD key.</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="setup_cdkey_entry">
                        <property name="visible">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="cdkey_cancel">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Cancel</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="setup_button_cdkey_continue">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">_Continue</property>
                            <property name="use-underline">True</property>
                            <property name="sensitive">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="license_dialog">
    <property name="title" translatable="yes">License Agreement</property>
    <property name="default-width">600</property>
    <property name="default-height">440</property>
    <property name="modal">True</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">16</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="shadow-type">in</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkTextView" id="license_area">
                <property name="visible">True</property>
                <property name="editable">False</property>
                <property name="wrap-mode">word-char</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="license_decline">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Cancel</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="license_agree">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Agree</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="readme_dialog">
    <property name="title" translatable="yes">Readme</property>
    <property name="default-width">600</property>
    <property name="default-height">440</property>
    <property name="modal">False</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin">16</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="shadow-type">in</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkTextView" id="readme_area">
                <property name="visible">True</property>
                <property name="editable">False</property>
                <property name="wrap-mode">word-char</property>
                <property name="left-margin">8</property>
                <property name="right-margin">8</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="readme_close">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Close</property>
                <property name="use-underline">True</property>
                <property name="sensitive">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
