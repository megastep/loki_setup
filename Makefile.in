DISTDIR = ..
SETUP_VERSION = @SETUP_VERSION_MAJOR@.@SETUP_VERSION_MINOR@.@SETUP_VERSION_RELEASE@
PACKAGE = setup-$(SETUP_VERSION)
DATADIR = .
LOCALEDIR = locale

arch := @ARCH@
libc := @LIBC@
os   := @OS@
BRANDELF = @BRANDELF@

# If you modify this version, change it's setup.xml and release a new patch.
UNINSTALL_VERSION = 1.0.4

CC = @CC@
CXX = @CXX@
AR = @AR@

# Sibling SetupDB build used by both console and graphical targets.
SETUPDB	= @SETUPDB@

IMAGE = @IMAGE@
BRAND = @BRAND@
UPDATES = /loki/updates/loki_uninstall
CONVERT_IMAGE = /loki/patch-tools/convert-image
GTK_VERSIONS = @GTK_VERSIONS@
DEFAULT_GTK = $(firstword $(GTK_VERSIONS))
SETUP_GTK = $(addprefix setup.,$(GTK_VERSIONS))
CHECK_GTK = $(addprefix check.,$(GTK_VERSIONS))
UNINSTALL_GTK = $(addprefix loki_uninstall.,$(GTK_VERSIONS))
DYN_PLUGINS = @DYN_PLUGINS@

# The supported locales so far
LOCALES = fr de es sv it nl ru en_GB pt
XGETTEXT = xgettext
MSGMERGE = msgmerge
MSGFMT = msgfmt

LD = @LD@
LDFLAGS = @LDFLAGS@
BDYNAMIC = @BDYNAMIC@
CPPFLAGS = @CPPFLAGS@ @DEPFLAGS@
OPTIONS = -DSTUB_UI -DSETUP_VERSION_MAJOR=@SETUP_VERSION_MAJOR@ \
		  -DSETUP_VERSION_MINOR=@SETUP_VERSION_MINOR@ \
		  -DSETUP_VERSION_RELEASE=@SETUP_VERSION_RELEASE@ \
		  -DSETUP_VERSION=\"$(SETUP_VERSION)\" \
		  -DMOUNT_PATH=\"@MOUNT_PATH@\" -DUMOUNT_PATH=\"@UMOUNT_PATH@\" \
		  -DDATADIR=\"$(DATADIR)\" -DLOCALEDIR=\"$(LOCALEDIR)\" -DLOKI_PREFIX=\"$(BRAND)\"

CFLAGS = @CFLAGS@ $(OPTIONS)
CXXFLAGS = @CXXFLAGS@ -DRARDLL -DSILENT

COMMON_OBJS = log.o install_log.o safe_path.o registry.o
CORE_OBJS   = detect.o encoding.o plugins.o network.o install.o copy.o file.o loki_launchurl.o bools.o
OBJS 		= $(COMMON_OBJS) $(CORE_OBJS) main.o 
LOKI_UNINSTALL_OBJS = loki_uninstall.o uninstall_ui.o safe_path.o registry.o
CARBON_UNINSTALL_OBJS = $(COMMON_OBJS) carbon_uninstall.o uninstall_carbonui.o
UNINSTALL_OBJS 		= $(COMMON_OBJS) uninstall.o
CHECK_OBJS			= $(COMMON_OBJS) $(CORE_OBJS) check.o
CHECK_CARBON_OBJS	= $(COMMON_OBJS) $(CORE_OBJS) check_carbon.o
CONSOLE_OBJS 		= $(OBJS) console_ui.o @CONSOLE_OBJS@
CARBON_OBJS          = $(OBJS) carbon_ui.o
SRCS = $(OBJS:.o=.c) $(CONSOLE_OBJS:.o=.c) gtk_ui.c gtk_setup_view.c $(CARBON_OBJS:.o=.c) testcd.c

COMMON_LIBS = plugins/libplugins.a @COMMON_LIBS@ \
	      $(SETUPDB)/$(arch)/libsetupdb.a
LIBS =  $(COMMON_LIBS) @LIBS@
ifeq ($(os),Linux)
GUI_LIBS = $(COMMON_LIBS) @LIBS@ $(1) @GUI_LIBS@
else
GUI_LIBS = $(COMMON_LIBS) $(1) @GUI_LIBS@ @LIBS@
endif
CARBON_LIBS = $(COMMON_LIBS) @LIBS@ @CARBON_LIBS@
CONSOLE_LIBS = $(LIBS) @CONSOLE_LIBS@ -lm

all: setup uninstall $(SETUP_GTK) $(CHECK_GTK) $(UNINSTALL_GTK)

smoke: export TEST_MAKE = $(MAKE)
smoke: all testencoding testrepair
	./testencoding
	sh tests/launcher.sh
	$(MAKE) -C "$(SETUPDB)" setupdb
	sh tests/smoke.sh "$(SETUPDB)/setupdb"

testencoding: tests/testencoding.o encoding.o
	$(CC) $(LDFLAGS) -o $@ $^ @LIBS@

testxml: testxml.o $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ testxml.o $(LIBS) -lm

loki_uninstall.o: uninstall.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $< -DUNINSTALL_UI -DVERSION=\"$(UNINSTALL_VERSION)\"

carbon_uninstall.o: uninstall.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $< -DUNINSTALL_CARBONUI -DUNINSTALL_UI -DVERSION=\"$(UNINSTALL_VERSION)\"

carbon_uninstall: $(CARBON_UNINSTALL_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $(CARBON_UNINSTALL_OBJS) $(CARBON_LIBS)
	rm -f -R ./uninstall.APP
	cp -R ./setup.APP ./uninstall.APP
	cp ./carbon/Info.plist.uninstall ./uninstall.APP/Contents/Info.plist
	rm -f ./uninstall.APP/Contents/MacOS/setup.carbon
	cp ./carbon_uninstall ./uninstall.APP/Contents/MacOS
uninstall: $(UNINSTALL_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $(UNINSTALL_OBJS) $(CONSOLE_LIBS) @STATIC@

check.carbon: $(CHECK_CARBON_OBJS)  $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $(CHECK_CARBON_OBJS) $(CARBON_LIBS)
	rm -f -R ./check.APP
	cp -R ./setup.APP ./check.APP
	cp ./carbon/Info.plist.check ./check.APP/Contents/Info.plist
	rm -f ./check.APP/Contents/MacOS/setup.carbon
	cp ./check.carbon ./check.APP/Contents/MacOS

testcd: testcd.o $(CORE_OBJS) $(COMMON_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $^ @LIBS@ @CONSOLE_LIBS@ @STATIC@

testrepair: tests/testrepair.o $(CORE_OBJS) $(COMMON_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $^ @LIBS@ @CONSOLE_LIBS@ @STATIC@

setup: $(CONSOLE_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $(CONSOLE_OBJS) $(CONSOLE_LIBS) @STATIC@

# Each front end gets its own objects and toolkit flags. Keep the shared
# installer engine independent of GTK.
gtk2_CFLAGS = @GTK2_CFLAGS@
gtk3_CFLAGS = @GTK3_CFLAGS@ -DLOKI_GTK3
gtk2_LIBS = @GTK2_LIBS@
gtk3_LIBS = @GTK3_LIBS@
gtk2_BOOLS = bools.o
gtk3_BOOLS = bools.gtk3.o

define gtk_targets
gtk_ui.$1.o gtk_setup_view.$1.o check.$1.o uninstall_ui.$1.o: %.$1.o: %.c Makefile config.h
	$$(CC) $$(CPPFLAGS) $$(CFLAGS) $$($1_CFLAGS) -c -o $$@ $$<

setup.$1: $$(filter-out bools.o,$$(OBJS)) $$($1_BOOLS) gtk_ui.$1.o gtk_setup_view.$1.o $$(COMMON_LIBS)
	$$(LD) $$(LDFLAGS) -o $$@ $$(filter-out $$(COMMON_LIBS),$$^) $$(call GUI_LIBS,$$($1_LIBS))

check.$1: $$(filter-out check.o bools.o,$$(CHECK_OBJS)) $$($1_BOOLS) check.$1.o $$(COMMON_LIBS)
	$$(LD) $$(LDFLAGS) -o $$@ $$(filter-out $$(COMMON_LIBS),$$^) $$(call GUI_LIBS,$$($1_LIBS))

loki_uninstall.$1: $$(filter-out uninstall_ui.o,$$(LOKI_UNINSTALL_OBJS)) uninstall_ui.$1.o $$(COMMON_LIBS)
	$$(LD) $$(LDFLAGS) -o $$@ $$(filter-out $$(COMMON_LIBS),$$^) $$(call GUI_LIBS,$$($1_LIBS))
endef

$(foreach version,$(GTK_VERSIONS),$(eval $(call gtk_targets,$(version))))

bools.gtk3.o: bools.c Makefile config.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -DLOKI_GTK3 -c -o $@ $<

ifneq ($(DEFAULT_GTK),)
check: check.$(DEFAULT_GTK) Makefile
	cp $< $@

loki_uninstall: loki_uninstall.$(DEFAULT_GTK) Makefile
	cp $< $@
else
.PHONY: check loki_uninstall
check loki_uninstall:
	@echo "Configure with GTK 3 or GTK 2 to build $@" >&2
	@exit 1
endif

#!!!TODO - Take dependency of dialog libs out of carbon	
#!!!TODO - Should we include setup.carbon as part of "all", "install", etc...?
# Carbon needs to be a target all its own
setup.carbon: $(CARBON_OBJS) $(COMMON_LIBS)
	$(LD) $(LDFLAGS) -o $@ $(CARBON_OBJS) $(CARBON_LIBS) 
	cp setup.carbon setup.APP/Contents/MacOS

plugins/libplugins.a: FORCE
	$(MAKE) -C plugins all

dialog/libdialog.a: FORCE
	$(MAKE) -C dialog all

do-plugins: plugins/libplugins.a
do-dialog: dialog/libdialog.a

.PHONY: all smoke clean dist distclean do-plugins do-dialog FORCE
FORCE:

# Keep one staging recipe for both the in-tree and external media.
MEDIA_ROOT = image
MEDIA_TOOLS = setup uninstall $(SETUP_GTK)
MEDIA_PLUGINS = $(if $(filter true,$(DYN_PLUGINS)),$(patsubst %.c,plugins/%.so,@PLUGINS@))
STRIP_MEDIA = yes

.PHONY: install install.dbg install-image install-setup install-uninstall
install install.dbg install-image: all
install-image install-setup install-uninstall: MEDIA_ROOT = $(IMAGE)
install.dbg: STRIP_MEDIA = no
install-setup: MEDIA_TOOLS = setup
install-uninstall: MEDIA_TOOLS = uninstall
install-setup install-uninstall: MEDIA_PLUGINS =
install-setup: setup
install-uninstall: uninstall

install install.dbg install-image install-setup install-uninstall:
	BRANDELF="$(BRANDELF)" STRIP_MEDIA="$(STRIP_MEDIA)" \
	  sh extras/stage-media.sh "$(MEDIA_ROOT)" "$(os)" "$(arch)" "$(libc)" "$@" $(MEDIA_TOOLS) $(MEDIA_PLUGINS)

	@if [ "$@" = install-image ] && [ "$(os)" = Linux ] && [ -d "$(CONVERT_IMAGE)" ]; then \
	    set -e; mkdir -p "$(CONVERT_IMAGE)/bin/$(os)/$(arch)"; \
	    cp uninstall "$(CONVERT_IMAGE)/bin/$(os)/$(arch)/"; \
	    strip "$(CONVERT_IMAGE)/bin/$(os)/$(arch)/uninstall"; \
	    $(BRANDELF) -t "$(os)" "$(CONVERT_IMAGE)/bin/$(os)/$(arch)/uninstall"; \
	fi

# Keep each graphical utility and its layout together. The legacy names
# point to the preferred version for media that invokes them directly.
.PHONY: install-check copy-loki_uninstall copy-image install-loki_uninstall
# Remove generated executable names only. Layouts and other media content can
# be shared with other builds or customized by the packager.
DISABLED_GTK = $(filter-out $(GTK_VERSIONS),gtk2 gtk3)
remove_disabled_gtk = rm -f $(if $(DEFAULT_GTK),,"$(1)/$(2)") $(foreach version,$(DISABLED_GTK),"$(1)/$(2).$(version)")

install-check: $(if $(DEFAULT_GTK),check $(CHECK_GTK))
	@dir="$(IMAGE)/bin/$(os)/$(arch)"; \
	if [ -d "$$dir" ]; then \
	    set -e; $(call remove_disabled_gtk,$$dir,check); \
	    [ -n "$(DEFAULT_GTK)" ] || exit 0; \
	    cp check $(CHECK_GTK) check.glade check.gtk2.glade check.gtk3.ui "$$dir/"; \
	    for tool in check $(CHECK_GTK); do strip "$$dir/$$tool"; done; \
	    mkdir -p "$(IMAGE)/misc"; cp check.glade check.gtk2.glade "$(IMAGE)/misc/"; \
	fi

copy-loki_uninstall: $(if $(DEFAULT_GTK),loki_uninstall $(UNINSTALL_GTK))
	@dir="$(IMAGE)/bin/$(os)/$(arch)/bin"; \
	if [ -d "$$dir" ]; then \
	    set -e; for version in $(DISABLED_GTK); do rm -f "$$dir/$$version/$(BRAND)-uninstall"; done; \
	    [ -n "$(DEFAULT_GTK)" ] || { rm -f "$$dir/$(BRAND)-uninstall"; exit 0; }; \
	    cp uninstall.glade uninstall.gtk2.glade uninstall.gtk3.ui "$$dir/"; \
	    cp loki_uninstall "$$dir/$(BRAND)-uninstall"; strip "$$dir/$(BRAND)-uninstall"; \
	    for version in $(GTK_VERSIONS); do \
	        mkdir -p "$$dir/$$version"; \
	        cp loki_uninstall.$$version "$$dir/$$version/$(BRAND)-uninstall"; \
	        cp uninstall.$$version.* "$$dir/$$version/"; \
	        strip "$$dir/$$version/$(BRAND)-uninstall"; \
	    done; \
	    for file in `find image/setup.data -name loki-uninstall.mo -print`; do \
	        path="$(IMAGE)/`dirname $$file | sed 's,image/setup.data/,,'`"; \
	        mkdir -p "$$path"; cp "$$file" "$$path"; \
	    done; \
	fi

copy-image: install-image copy-loki_uninstall po-image

install-loki_uninstall: $(if $(DEFAULT_GTK),loki_uninstall $(UNINSTALL_GTK))
	@dir="$(IMAGE)/loki_uninstall/bin/$(arch)/$(libc)"; \
	if [ -d "$$dir" ]; then \
	    set -e; $(call remove_disabled_gtk,$$dir,loki_uninstall); \
	fi; \
	if [ -n "$(DEFAULT_GTK)" ] && [ -d "$$dir" ]; then \
	    set -e; cp loki_uninstall $(UNINSTALL_GTK) uninstall.glade uninstall.gtk2.glade uninstall.gtk3.ui "$$dir/"; \
	    for tool in loki_uninstall $(UNINSTALL_GTK); do strip "$$dir/$$tool"; done; \
	    cp README.loki_uninstall "$(IMAGE)/loki_uninstall/README"; \
	    cp icon.xpm uninstall.glade uninstall.gtk2.glade uninstall.gtk3.ui "$(IMAGE)/loki_uninstall/"; \
	    for file in `find image/setup.data -name loki-uninstall.mo -print`; do \
	        path="$(IMAGE)/loki_uninstall/`dirname $$file | sed 's,image/setup.data/,,'`"; \
	        mkdir -p "$$path"; cp "$$file" "$$path"; \
	    done; \
	fi
	@dir="$(UPDATES)/bin-$(arch)-$(UNINSTALL_VERSION)"; \
	if [ -d "$$dir" ]; then \
	    set -e; $(call remove_disabled_gtk,$$dir,loki_uninstall); \
	fi; \
	if [ -n "$(DEFAULT_GTK)" ] && [ -d "$(UPDATES)" ]; then \
	    set -e; mkdir -p "$(UPDATES)/bin-$(arch)-$(UNINSTALL_VERSION)" "$(UPDATES)/data-$(UNINSTALL_VERSION)"; \
	    cp loki_uninstall $(UNINSTALL_GTK) "$(UPDATES)/bin-$(arch)-$(UNINSTALL_VERSION)/"; \
	    for tool in loki_uninstall $(UNINSTALL_GTK); do strip "$(UPDATES)/bin-$(arch)-$(UNINSTALL_VERSION)/$$tool"; done; \
	    cp icon.xpm uninstall.glade uninstall.gtk2.glade uninstall.gtk3.ui "$(UPDATES)/data-$(UNINSTALL_VERSION)/"; \
	    for file in `find image/setup.data -name loki-uninstall.mo -print`; do \
	        path="$(UPDATES)/data-$(UNINSTALL_VERSION)/`dirname $$file | sed 's,image/setup.data/,,'`"; \
	        mkdir -p "$$path"; cp "$$file" "$$path"; \
	    done; \
	fi
	@echo "Don't forget to update the version in setup.xml to $(UNINSTALL_VERSION)"

po-image:
	@set -e; for lang in $(LOCALES); do \
		dir="locale/$$lang/LC_MESSAGES"; \
		mkdir -p "$(IMAGE)/setup.data/$$dir"; \
		if ! test "image/setup.data/$$dir" -ef "$(IMAGE)/setup.data/$$dir"; then \
			cp -f image/setup.data/"$$dir"/*.mo "$(IMAGE)/setup.data/$$dir/"; \
		fi; \
		if test -d "$(CONVERT_IMAGE)"; then \
			mkdir -p "$(CONVERT_IMAGE)/$$dir"; \
			cp -f "image/setup.data/$$dir/loki-uninstall.mo" "$(CONVERT_IMAGE)/$$dir/"; \
		fi; \
	done

clean:
	$(MAKE) -C plugins clean
	$(MAKE) -C dialog clean
	rm -f foo.xml core tags *.o *.d
	rm -f carbon/*.o carbon/*.d
	rm -f unrar/*.o unrar/*.d tests/*.o tests/*.d

distclean: clean
	rm -f Makefile dialog/Makefile plugins/Makefile .depend dialog/.depend plugins/.depend config.h config.cache config.status config.log
	rm -f setup setup.gtk setup.gtk2 setup.gtk3 setup.carbon uninstall loki_uninstall loki_uninstall.gtk2 loki_uninstall.gtk3 testxml testcd testencoding testrepair xsu check check.gtk2 check.gtk3 check.carbon carbon_uninstall

DISTFILES = $(wildcard *.c *.h *.glade *.ui README*) THEMING.md configure.ac configure config.h.in \
            config.guess config.sub install-sh autogen.sh Makefile Makefile.in \
            BUGS CHANGES COPYING Patches icon.xpm loki_uninstall.spec setupdb.rev .github .gitignore \
            carbon dialog extras image makeself plugins po setup.APP tests unrar

dist:
	@set -e; work=$$(mktemp -d); trap 'rm -rf "$$work"' 0; \
	mkdir "$$work/$(PACKAGE)"; \
	cp -R $(DISTFILES) "$$work/$(PACKAGE)/"; \
	$(MAKE) -C "$$work/$(PACKAGE)" distclean; \
	tar -C "$$work" -czf "$$work/release.tar.gz" "$(PACKAGE)"; \
	mv "$$work/release.tar.gz" "$(DISTDIR)/$(PACKAGE).tar.gz"

PO_PLUGINS = $(wildcard plugins/*.c)
PO_SETUP = $(sort $(SRCS) dialog_ui.c $(PO_PLUGINS) $(wildcard image/setup.data/setup*.glade image/setup.data/setup*.ui))
PO_UNINSTALL = $(sort $(CHECK_OBJS:.o=.c) check_carbon.c uninstall.c uninstall_ui.c \
                    uninstall_carbonui.c $(PO_PLUGINS) $(wildcard check*.glade uninstall*.glade check*.ui uninstall*.ui))
XGETTEXT_FLAGS = --from-code=UTF-8 --keyword=_ --keyword=gettext_noop \
                 --add-comments=TRANSLATORS: --package-name='Loki Setup' \
                 --package-version=$(SETUP_VERSION)

po/setup.pot: $(PO_SETUP) Makefile.in
	$(XGETTEXT) $(XGETTEXT_FLAGS) -o $@ $(PO_SETUP)

po/loki-uninstall.pot: $(PO_UNINSTALL) Makefile.in
	$(XGETTEXT) $(XGETTEXT_FLAGS) -o $@ $(PO_UNINSTALL)

.PHONY: gettext update-po po-image
gettext:
	@set -e; for lang in $(LOCALES); do \
		dir="image/setup.data/locale/$$lang/LC_MESSAGES"; \
		mkdir -p "$$dir"; \
		for domain in setup loki-uninstall; do \
			$(MSGFMT) --check -o "$$dir/$$domain.mo" "po/$$lang/$$domain.po"; \
		done; \
	done

update-po: po/setup.pot po/loki-uninstall.pot
	@set -e; for lang in $(LOCALES); do \
		for domain in setup loki-uninstall; do \
			$(MSGMERGE) --update --backup=none --previous "po/$$lang/$$domain.po" "po/$$domain.pot"; \
		done; \
	done

.PHONY: dep depend
dep depend: all

# Recompile when configuration or a header used by an object changes.
$(sort $(SRCS:.c=.o) $(UNINSTALL_OBJS) $(CHECK_OBJS) $(LOKI_UNINSTALL_OBJS) testxml.o testcd.o tests/testencoding.o tests/testrepair.o $(filter %.o,$(COMMON_LIBS))): Makefile config.h
-include $(wildcard *.d carbon/*.d unrar/*.d tests/*.d)
