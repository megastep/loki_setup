#: uninstall.c:52
#, c-format
msgid ""
"Usage: %s [options] [product [component ...]]\n"
"\n"
"  -h, --help             Show this help.\n"
"  -l, --list             List installed products or a product's components.\n"
"  -v, --version          Show version information.\n"
"  -L, --locale product   Use translations from the product's installation.\n"
"\n"
"Without --list, specify a product to uninstall it or name individual "
"components.\n"
msgstr ""
"Utilização: %s [opções] [produto [componente ...]]\n"
"\n"
"  -h, --help             Mostra esta ajuda.\n"
"  -l, --list             Lista os produtos instalados ou os componentes de "
"um produto.\n"
"  -v, --version          Mostra as informações da versão.\n"
"  -L, --locale product   Usa as traduções da instalação do produto "
