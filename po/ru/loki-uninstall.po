#: uninstall.c:52
#, c-format
msgid ""
"Usage: %s [options] [product [component ...]]\n"
"\n"
"  -h, --help             Show this help.\n"
"  -l, --list             List installed products or a product's components.\n"
"  -v, --version          Show version information.\n"
"  -L, --locale product   Use translations from the product's installation.\n"
"\n"
"Without --list, specify a product to uninstall it or name individual "
"components.\n"
msgstr ""
"Использование: %s [параметры] [продукт [компонент ...]]\n"
"\n"
"  -h, --help              Показать эту справку.\n"
"  -l, --list              Показать установленные продукты или компоненты "
"продукта.\n"
"  -v, --version           Показать сведения о версии.\n"
"  -L, --locale продукт    Использовать переводы из каталога установки "
"продукта.\n"
"\n"
"Без --list укажите продукт для удаления или перечислите отдельные "
"компоненты.\n"

