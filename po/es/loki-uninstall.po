#: uninstall.c:52
#, c-format
msgid ""
"Usage: %s [options] [product [component ...]]\n"
"\n"
"  -h, --help             Show this help.\n"
"  -l, --list             List installed products or a product's components.\n"
"  -v, --version          Show version information.\n"
"  -L, --locale product   Use translations from the product's installation.\n"
"\n"
"Without --list, specify a product to uninstall it or name individual "
"components.\n"
msgstr ""
"Uso: %s [opciones] [producto [componente ...]]\n"
"\n"
"  -h, --help              Mostrar esta ayuda.\n"
"  -l, --list              Listar los productos instalados o los componentes "
"de un producto.\n"
"  -v, --version           Mostrar información de la versión.\n"
"  -L, --locale producto   Usar las traducciones de la instalación del "
"producto.\n"
"\n"
"Sin --list, indique un producto para desinstalarlo o indique componentes "
"individuales.\n"

