#
# Makefile for the setup plugins
# $Id: Makefile.in,v 1.7 2008-07-25 22:56:53 megastep Exp $
#

STATICS = cpio.c
PLUGINS = @PLUGINS@
CPPFLAGS = @CPPFLAGS@ @DEPFLAGS@
CFLAGS  = -fPIC @CFLAGS@ -I..
CC	= @CC@
AR	= @AR@
DYN_PLUGINS = @DYN_PLUGINS@

.SUFFIXES: .so .o .c

OBJS	= $(STATICS:.c=.o)

ifeq ($(DYN_PLUGINS),true)

# Build all plugins as .so files
SOBJS = $(PLUGINS:.c=.so)

all: $(SOBJS) libplugins.a

else

# Make a libplugin.a archive that will be linked with the main program
OBJS += $(PLUGINS:.c=.o)

all: libplugins.a

endif

libplugins.a: $(OBJS) Makefile
	rm -f $@
	$(AR) rcs $@ $(OBJS)

.c.so:
	$(CC) @LDFLAGS@ @PLUGIN_LDFLAGS@ -o $@ $*.c $(CPPFLAGS) $(CFLAGS)
.c.o:
	$(CC) -o $@ -c $*.c $(CPPFLAGS) $(CFLAGS)

clean:
	rm -f *.o *.d *.so *.a *~

.PHONY: dep depend
dep depend: all

$(OBJS) $(SOBJS): Makefile ../config.h
-include $(wildcard *.d)
